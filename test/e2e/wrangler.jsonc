{
  // 브라우저·부하 시험 전용 설정. 배포에 쓰지 않는다 (루트 wrangler.jsonc 가 배포용).
  // 실행: npm run e2e:serve (빌드 + 깨끗한 상태로 wrangler dev, http://localhost:8791)
  //       npm run e2e        (위 서버를 띄우고 브라우저 시나리오를 돌린 뒤 끈다)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nanumboard-e2e",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/__test/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry", "Board"] }],
  // 가짜 값 (가짜 Google 이 받는다). 실제 값은 넣지 않는다.
  "vars": {
    "GOOGLE_CLIENT_ID": "e2e-test.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "e2e-test-secret"
  }
}
