{
  // 브라우저 시험 전용 설정. 배포에 쓰지 않는다 (루트 wrangler.jsonc 가 배포용).
  // 실행: npx vite build --config web/vite.config.ts && npx wrangler dev -c test/e2e/wrangler.e2e.jsonc --port 8790 --persist-to <임시 폴더>
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nanumboard-e2e",
  "main": "./dev-worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/__test/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry", "Board"] }],
  "vars": {
    "GOOGLE_CLIENT_ID": "e2e-test.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "e2e-test-secret"
  }
}
