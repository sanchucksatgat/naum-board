{
  // 보드 화면 브라우저 시험 전용 (태스크4). 배포에 쓰지 않는다 (루트 wrangler.jsonc 가 배포용).
  // 실행: node test/board-e2e/run.mjs   (빌드 + wrangler dev + Playwright 시나리오)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nanumboard-board-e2e",
  "main": "./dev-worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/__test/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry", "Board"] }],
  "vars": {
    "GOOGLE_CLIENT_ID": "board-e2e.apps.googleusercontent.com",
    "GOOGLE_CLIENT_SECRET": "board-e2e-secret"
  }
}
